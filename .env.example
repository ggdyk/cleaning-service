# =============================================================================
# Cleaning Service Platform — переменные окружения
# =============================================================================
# Скопируй этот файл в .env и замени значения под своё окружение:
#   cp .env.example .env
#
# ВАЖНО: .env НЕ коммитится в git (добавлен в .gitignore)
# =============================================================================

# --- PostgreSQL ---
POSTGRES_DB=cleaning_platform_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=devpassword123

# --- JWT ---
# Минимум 32 символа. В production использовать случайную строку.
Jwt__Key=your-super-secret-key-minimum-32-characters-long-for-security
Jwt__Issuer=CleaningServiceApi
Jwt__Audience=CleaningServiceClient

# --- Калькулятор (опционально, перекрывает appsettings.json) ---
Calculator__PricePerSquareMeter=50.0
Calculator__PricePerBathroom=1000.0
Calculator__MinimumOrderAmount=3000.0

# --- API ---
API_PORT=8080
ASPNETCORE_ENVIRONMENT=Production
